{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "esModuleInterop": true,
    "lib": ["es2015"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ESNext",
    "skipLibCheck": true,
  },
  "include": ["src/**/*.ts", "src/types/**/*.d.ts"]
}
