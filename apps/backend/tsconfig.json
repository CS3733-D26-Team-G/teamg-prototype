{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["es2015"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts", "src/types/**/*.d.ts"]
}
