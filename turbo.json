{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "outputs": [
        "node_modules/.prisma/**",
        "node_modules/@prisma/client/**",
        "../zod/generated/schemas/**"
      ]
    },
    "db:generate-prod": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "outputs": [
        "node_modules/.prisma/**",
        "node_modules/@prisma/client/**",
        "../zod/generated/schemas/**"
      ]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "dev:prod": {
      "dependsOn": ["^db:generate-prod"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^db:generate-prod"],
      "outputs": ["dist/**", ".vite/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
