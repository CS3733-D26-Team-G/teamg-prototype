{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "db:generate-prod": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "dev:prod": {
      "dependsOn": ["^db:generate-prod"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^db:generate"],
      "outputs": ["dist/**", ".vite/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
